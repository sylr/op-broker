<?xml version="1.0" encoding="UTF-8"?>
<!--
  LaunchAgent for opbd. It must be a LaunchAgent (running in your GUI login
  session), not a LaunchDaemon: 1Password desktop-app integration needs the
  user session. `make install-agent` substitutes __HOME__ and __OPBD__.
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.sylr.op-broker</string>
  <key>ProgramArguments</key>
  <array>
    <string>__OPBD__</string>
    <string>-config</string>
    <string>__HOME__/Library/Application Support/op-broker/config.yaml</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>ThrottleInterval</key>
  <integer>30</integer>
  <key>ProcessType</key>
  <string>Interactive</string>
  <!-- 077: files created by opbd are private to the user. -->
  <key>Umask</key>
  <integer>63</integer>
  <!-- Startup errors only; the audit log goes to log_file. -->
  <key>StandardErrorPath</key>
  <string>__HOME__/Library/Logs/op-broker.stderr.log</string>
</dict>
</plist>
